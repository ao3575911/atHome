{
  "name": "@athome/root",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "npm run dev -w @athome/api",
    "demo": "tsx scripts/demo.ts",
    "format": "prettier --write .",
    "generate:sdk": "tsx scripts/generate-sdk.ts",
    "lint": "prettier --check .",
    "audit:high": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:web": "npm run dev -w @athome/web",
    "build:web": "npm run build -w @athome/web",
    "typecheck:web": "npm run typecheck -w @athome/web",
    "verify:postgres": "tsx scripts/verify-postgres.ts",
    "build:packages": "npm run build -w @ao3575911/protocol -w @ao3575911/sdk",
    "stress": "tsx scripts/stress.ts"
  },
  "dependencies": {
    "@ao3575911/protocol": "0.4.0",
    "@ao3575911/sdk": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "postcss": "8.5.31",
    "vite": "6.4.5",
    "@fastify/static": "10.1.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
