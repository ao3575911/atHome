{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athome.local/schemas/a1/identity.schema.json",
  "title": "A1 provisional identity document",
  "description": "Provisional A1 contract. It does not replace the current atHome IdentityManifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "keys", "createdAt", "updatedAt"],
  "properties": {
    "version": {
      "const": "a1",
      "description": "Provisional A1 envelope version."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/key"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "algorithm",
        "encoding",
        "publicKey",
        "purpose",
        "status",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "encoding": {
          "enum": ["spki-der-base64", "raw-base64url"]
        },
        "publicKey": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["active", "deprecated", "revoked"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "algorithm", "keyId", "signature"],
      "properties": {
        "version": {
          "const": "a1"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
