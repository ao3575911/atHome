{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athome.local/schemas/a1/capability-grant.schema.json",
  "title": "A1 provisional capability grant",
  "description": "Provisional A1 contract. It does not replace the current atHome CapabilityToken.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "issuer",
    "subject",
    "permissions",
    "issuedAt",
    "expiresAt",
    "signature"
  ],
  "properties": {
    "version": {
      "const": "a1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "denied": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "$ref": "attestation.schema.json#/$defs/signature"
    }
  }
}
