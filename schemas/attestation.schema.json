{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athome.local/schemas/a1/attestation.schema.json",
  "title": "A1 provisional attestation",
  "description": "Provisional A1 contract. Verifiers must establish issuer trust independently of this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "issuer",
    "subject",
    "claims",
    "issuedAt",
    "signature"
  ],
  "properties": {
    "version": {
      "const": "a1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": true
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "algorithm", "keyId", "signature"],
      "properties": {
        "version": {
          "const": "a1"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
